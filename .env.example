# BamanaShop - Environment Variables
# Copy this file to .env.local (for local development) or .env (for CI/production)
# NEVER commit .env files to git

# ============================================================================
# Supabase (Required for all apps)
# ============================================================================
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# For React Native CLI apps (Customer & Pro)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# Payment Providers (Mock during bootstrap - fill after access validation)
# ============================================================================
# Orange Money - requires merchant onboarding
ORANGE_MONEY_MERCHANT_KEY=your_merchant_key
ORANGE_MONEY_MERCHANT_SECRET=your_merchant_secret
ORANGE_MONEY_WEBHOOK_SECRET=your_webhook_secret
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay

# Cash on Delivery - no external config needed
# COD settings managed in Admin > Settings > Delivery Partners

# ============================================================================
# Delivery Partners (Mock during bootstrap)
# ============================================================================
# Configured in Admin dashboard - no env vars needed for MVP

# ============================================================================
# Monitoring & Observability (Optional)
# ============================================================================
# SENTRY_DSN=your_sentry_dsn
# LOGTAIL_SOURCE_TOKEN=your_logtail_token

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_ORANGE_MONEY=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false

# ============================================================================
# Admin
# ============================================================================
ADMIN_EMAILS=admin@bamanashop.gn