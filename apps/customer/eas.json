{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "pnpm": "12.21.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "pnpm": "12.21.0",
      "image": "ubuntu-22.04"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "pnpm": "12.21.0",
      "image": "ubuntu-22.04"
    }
  },
  "submit": {
    "production": {}
  }
}
