{
  "name": "@bamanashop/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.mjs",
      "require": "./dist/zod.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -m ESNext --outDir dist/esm --declarationDir dist/esm && mv dist/esm/* dist/ && cp dist/index.js dist/index.mjs",
    "lint": "eslint src --ext .ts",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}